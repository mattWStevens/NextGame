{
    "name": "@nextgame/api",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch --env-file=../../.env src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "lint": "eslint src/",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:push": "prisma db push",
        "db:seed": "tsx prisma/seed.ts",
        "postinstall": "prisma generate"
    },
    "dependencies": {
        "@fastify-extra/connect-redis": "^1.0.1",
        "@fastify/cookie": "^9.4.0",
        "@fastify/session": "^10.9.0",
        "@nextgame/shared": "workspace:*",
        "@prisma/adapter-pg": "^7.4.2",
        "@prisma/client": "^7.4.2",
        "@trpc/server": "^11.12.0",
        "@types/bcrypt": "^6.0.0",
        "bcrypt": "^6.0.0",
        "dotenv": "^17.3.1",
        "fastify": "^4.28.0",
        "pg": "^8.20.0",
        "rate-limiter-flexible": "^10.0.1",
        "redis": "^5.11.0"
    },
    "devDependencies": {
        "@types/node": "^20.14.0",
        "@types/pg": "^8.18.0",
        "msw": "^2.13.2",
        "prisma": "^7.4.2",
        "tsx": "^4.16.0",
        "typescript": "^5.4.0"
    }
}
