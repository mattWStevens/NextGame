# ── Required ─────────────────────────────────────────────────────────────────

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nextgame

# Redis
REDIS_URL=redis://localhost:6379

# IGDB API Credentials (https://api-docs.igdb.com/#getting-started)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Session secret — must be at least 32 characters
SESSION_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────

# AI Provider — at least one required to use the Vibe Recommender
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Server
API_PORT=3001
